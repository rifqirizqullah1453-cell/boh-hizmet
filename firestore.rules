rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // active_orders: read-only mirror for Worker/Client Apps.
    // All writes go through the server's Firebase Admin SDK (bypasses rules).
    // ponytail: any signed-in user can read; per-role scoping needs custom claims.
    match /active_orders/{orderId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // worker_locations: worker app writes its own GPS coordinates here
    // so the customer app can show real-time worker position on the map.
    match /worker_locations/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // chats: in-app messaging between worker and customer for an order.
    // Messages are append-only — no updates or deletes allowed.
    // Only the order's customer/worker (per the active_orders mirror) may access.
    match /chats/{orderId}/messages/{messageId} {
      function isParticipant() {
        let o = get(/databases/$(database)/documents/active_orders/$(orderId)).data;
        return request.auth != null
          && (o.get('customerFirebaseUid', '') == request.auth.uid
              || o.get('workerFirebaseUid', '') == request.auth.uid);
      }
      allow read: if isParticipant();
      allow create: if isParticipant()
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 500;
      allow update, delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
